{
   "compilerOptions": {
      "target": "ES2024",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "lib": ["ES2024", "DOM", "DOM.Iterable"],
      "jsx": "react-jsx",
      "strict": true,
      "skipLibCheck": true,
      "declaration": true,
      "emitDeclarationOnly": true,
      "outDir": "dist"
   },
   "include": ["src"]
}
