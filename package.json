{
   "name": "finance-os",
   "version": "1.0.0",
   "private": true,
   "description": "FinanceOS - Personal Finance Management Platform",
   "scripts": {
      "dev": "pnpm -r --parallel dev",
      "build": "pnpm -r build",
      "lint": "pnpm -r --if-present lint",
      "typecheck": "pnpm -r --if-present typecheck",
      "test": "pnpm -r --if-present test",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
   },
   "engines": {
      "node": ">=26",
      "pnpm": ">=12 <13"
   },
   "packageManager": "pnpm@12.5.1",
   "devDependencies": {
      "prettier": "3.9.9",
      "typescript": "^5.9.2"
   }
}
